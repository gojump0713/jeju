---
// S05 AI meets JEJU (작업지시서 4.5, 7.2, 9.1)
// - 행사 메시지를 보여주는 개념 영상 — 실제 적용 실적처럼 표현하지 않는다.
// - 기본은 HF-I08 정지 이미지. Desktop(≥768)에서만, viewport 근처에 왔을 때 HF-V02 로드.
// - reduced motion·Data Saver면 영상 생략. 일시정지 버튼 제공, 사용자 정지 후 자동 재시작 안 함.
const hf = `${import.meta.env.BASE_URL}assets/hf`;
---

<section class="aijeju" aria-labelledby="aijeju-title" data-aijeju>
  <div class="aijeju-media" aria-hidden="true">
    <img
      class="aijeju-poster"
      src={`${hf}/hf-i08-aijeju-v01-1200w.webp`}
      srcset={`${hf}/hf-i08-aijeju-v01-1200w.webp 1200w, ${hf}/hf-i08-aijeju-v01.webp 1920w`}
      sizes="100vw"
      width="1920"
      height="1080"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <video
      class="aijeju-video"
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
      data-aijeju-video
      data-src={`${hf}/hf-v02-aijeju-v01.mp4`}
    ></video>
    <div class="aijeju-overlay"></div>
  </div>

  <div class="container aijeju-content">
    <h3 id="aijeju-title" class="aijeju-title">AI meets JEJU</h3>
    <p class="aijeju-desc">AI 서비스가 제주 산업과 만날 때 새로운 가능성이 시작됩니다.</p>
  </div>

  <button class="aijeju-toggle" type="button" hidden aria-pressed="false" data-aijeju-toggle>
    <span class="aijeju-toggle-icon" aria-hidden="true"></span>
    <span data-aijeju-toggle-label>배경 영상 일시정지</span>
  </button>
</section>

<style>
  .aijeju {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(440px, 56vw, 640px);
    padding: 96px 0;
    color: #fff;
    background: var(--surface-dark);
    overflow: hidden;
    isolation: isolate;
    text-align: center;
  }
  .aijeju-media,
  .aijeju-poster,
  .aijeju-video,
  .aijeju-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .aijeju-media {
    z-index: -1;
  }
  .aijeju-poster,
  .aijeju-video {
    object-fit: cover;
  }
  .aijeju-video {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .aijeju-video[data-playing='true'] {
    opacity: 1;
  }
  /* 밝은 이미지 위 흰 글자 대비 확보: 중앙을 더 어둡게 */
  .aijeju-overlay {
    background:
      radial-gradient(ellipse 70% 60% at 50% 45%, rgba(8, 21, 35, 0.62) 0%, rgba(8, 21, 35, 0.35) 100%);
  }

  .aijeju-title {
    margin: 0;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .aijeju-desc {
    max-width: 640px;
    margin: 20px auto 0;
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    font-weight: 600;
    line-height: 1.6;
    text-shadow: 0 1px 12px rgba(8, 21, 35, 0.5);
  }

  .aijeju-toggle {
    position: absolute;
    right: var(--gutter);
    bottom: 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    background: rgba(8, 21, 35, 0.55);
    color: #fff;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .aijeju-toggle-icon {
    width: 10px;
    height: 12px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .aijeju-toggle[aria-pressed='true'] .aijeju-toggle-icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent currentColor;
  }
  .aijeju :focus-visible {
    outline-color: #8fc3ff;
  }

  @media (max-width: 767px) {
    .aijeju {
      min-height: 420px;
      padding: 72px 0;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-aijeju]');
  const video = document.querySelector<HTMLVideoElement>('[data-aijeju-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-aijeju-toggle]');
  const label = document.querySelector<HTMLElement>('[data-aijeju-toggle-label]');

  if (section && video && toggle && label) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 768px)');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

    let near = false;
    let inView = false;
    let userPaused = false;

    const allowed = () => !reduced.matches && !saveData && desktop.matches;

    const setLabel = () => {
      toggle.setAttribute('aria-pressed', String(userPaused));
      label.textContent = userPaused ? '배경 영상 재생' : '배경 영상 일시정지';
    };

    const unload = () => {
      video.pause();
      video.removeAttribute('src');
      video.load();
      video.dataset.playing = 'false';
      toggle.hidden = true;
    };

    const sync = () => {
      if (!allowed()) return unload();
      if (!near) return;
      if (!video.getAttribute('src')) {
        video.src = video.dataset.src ?? '';
        toggle.hidden = false;
        setLabel();
      }
      if (inView && !userPaused && !document.hidden) video.play().catch(() => (video.dataset.playing = 'false'));
      else video.pause();
    };

    video.addEventListener('playing', () => (video.dataset.playing = 'true'));
    video.addEventListener('error', unload);

    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      setLabel();
      sync();
    });

    // viewport 근처(아래 300px)에 도달하기 전에는 로드하지 않음 (9.1)
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) near = true;
        sync();
      },
      { rootMargin: '300px 0px' },
    ).observe(section);
    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      sync();
    }).observe(section);

    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
    desktop.addEventListener('change', sync);
  }
</script>
