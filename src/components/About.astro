---
// S03 About + 서비스 카드 4종 (작업지시서 4.3, 6장, 7.2)
// Desktop 텍스트:이미지 6:6 / Tablet·Mobile 텍스트 → 이미지
// 카드 Desktop 4열 / Tablet 2×2 / Mobile 1열 (carousel 사용 안 함). 가짜 링크·'자세히 보기' 없음.
// 하위 콘텐츠(프로그램·AI meets JEJU·행사 정보)는 slot으로 받아 #about 안에 둔다 (2장 정보 구조).
import { services } from '@/data/event';

const hf = `${import.meta.env.BASE_URL}assets/hf`;
const cardImage: Record<string, string> = {
  'HF-I04': 'hf-i04-dstationx-v01',
  'HF-I05': 'hf-i05-tos-v01',
  'HF-I06': 'hf-i06-kstory-v01',
  'HF-I07': 'hf-i07-town-v01',
};
---

<section id="about" class="about" aria-labelledby="about-title">
  <div class="section about-intro-wrap">
    <div class="container">
      <div class="about-intro">
        <div class="about-text">
          <h2 id="about-title" class="section-label">행사 소개</h2>
          <p class="section-title about-headline">구축형 인프라에서<br class="br-desktop" /> 서비스형 AI·Cloud로</p>
          <p class="section-lead">틸론소프트가 준비한 새로운 변화가 제주에서 시작됩니다.</p>
        </div>
        <div class="about-visual">
          <img
            src={`${hf}/hf-i03-about-v01-1200w.webp`}
            srcset={`${hf}/hf-i03-about-v01-1200w.webp 1200w, ${hf}/hf-i03-about-v01.webp 1920w`}
            sizes="(min-width: 1200px) 588px, calc(100vw - 2 * var(--gutter))"
            width="1920"
            height="1080"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <h3 class="sr-only">소개 서비스</h3>
      <ol class="service-grid">
        {
          services.map((s) => (
            <li class="service-card" data-accent={s.accent}>
              <img
                class="service-image"
                src={`${hf}/${cardImage[s.assetId]}-800w.webp`}
                srcset={`${hf}/${cardImage[s.assetId]}-800w.webp 800w, ${hf}/${cardImage[s.assetId]}.webp 1200w`}
                sizes="(min-width: 1200px) 282px, (min-width: 768px) calc(50vw - 42px), calc(100vw - 40px)"
                width="1200"
                height="900"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <div class="service-body">
                <p class="service-label">
                  <span class="service-order">{s.order}</span>
                  <span class="service-dot" aria-hidden="true" />
                  {s.label}
                </p>
                <h4 class="service-name">{s.name}</h4>
                <p class="service-desc">{s.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <slot />
</section>

<style>
  .about-intro-wrap {
    background: var(--surface-light);
  }

  .about-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 48px;
  }
  .about-headline {
    margin-top: 12px;
  }
  .about-visual img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-card);
    background: var(--surface-dark);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: 72px 0 0;
    padding: 0;
    list-style: none;
  }
  .service-card {
    --accent: var(--brand-blue);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface-white);
    box-shadow: 0 1px 2px rgba(8, 21, 35, 0.06), 0 8px 24px rgba(8, 21, 35, 0.06);
  }
  .service-card[data-accent='green'] {
    --accent: var(--brand-green);
  }
  .service-card[data-accent='yellow'] {
    --accent: var(--brand-yellow);
  }
  .service-card[data-accent='orange'] {
    --accent: var(--brand-orange);
  }
  .service-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--surface-dark);
  }
  .service-body {
    flex: 1;
    padding: 24px 24px 28px;
    border-top: 3px solid var(--accent);
  }
  .service-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .service-order {
    color: var(--text-primary);
  }
  .service-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .service-name {
    margin: 12px 0 0;
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .service-desc {
    margin: 8px 0 0;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 1199px) {
    .about-intro {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .br-desktop {
      display: none;
    }
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-top: 56px;
    }
  }

  @media (max-width: 767px) {
    .about-intro {
      gap: 32px;
    }
    .service-grid {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 40px;
    }
  }
</style>
