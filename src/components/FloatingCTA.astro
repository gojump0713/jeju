---
// 모바일 sticky 참가신청 CTA (작업지시서 7.4)
// - Hero 신청 버튼이 화면 밖으로 나가면 표시.
// - 신청 영역이 보이거나 입력 중(가상 키보드), 메뉴·완료 모달이 열림, 신청 완료 상태에서는 숨김.
// - 모든 #registration 링크는 스크롤 후 신청 영역 제목으로 focus 이동 (첫 입력칸 자동 focus 안 함).
---

<div class="floating-cta" aria-hidden="true" data-floating>
  <a class="btn btn-primary btn-lg" href="#registration" tabindex="-1" data-cta="floating">참가신청하기</a>
</div>

<style>
  .floating-cta {
    display: none;
  }
  @media (max-width: 767px) {
    .floating-cta {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 90;
      display: block;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.92) 30%);
      transform: translateY(110%);
      transition: transform 0.25s ease;
    }
    .floating-cta[data-visible='true'] {
      transform: none;
    }
    .floating-cta .btn {
      width: 100%;
      box-shadow: 0 8px 20px rgba(1, 94, 168, 0.3);
    }
    /* 문서 끝 여백(bar 높이 + safe area)은 Footer 하단 padding으로 확보 (7.4) */
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-floating]');
  const link = bar?.querySelector<HTMLAnchorElement>('a');
  const heroCta = document.querySelector('[data-hero-cta]');
  const heading = document.getElementById('registration-title');

  // #registration 링크 공통 처리: 스크롤 후 제목에 focus
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a[href="#registration"]');
    if (!a || !heading) return;
    e.preventDefault();
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.getElementById('registration')?.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto' });
    heading.focus({ preventScroll: true });
    history.replaceState(null, '', '#registration');
  });

  if (bar && link && heroCta) {
    const state = {
      heroVisible: true,
      registrationVisible: false,
      typing: false,
      menuOpen: false,
      modalOpen: false,
      registered: false,
    };

    const render = () => {
      const show =
        !state.heroVisible && !state.registrationVisible && !state.typing && !state.menuOpen && !state.modalOpen && !state.registered;
      bar.dataset.visible = String(show);
      bar.setAttribute('aria-hidden', String(!show));
      link.tabIndex = show ? 0 : -1;
    };

    new IntersectionObserver(([entry]) => {
      state.heroVisible = entry.isIntersecting;
      render();
    }).observe(heroCta);

    // 신청 영역(폼·동의·제출 버튼)이 조금이라도 보이면 숨김 — 동의 체크박스·오류 문구를 가리지 않도록 (7.4)
    const registration = document.getElementById('registration');
    if (registration) {
      new IntersectionObserver(([entry]) => {
        state.registrationVisible = entry.isIntersecting;
        render();
      }).observe(registration);
    }

    // 입력 중에는 가상 키보드가 열린 것으로 보고 숨김
    document.addEventListener('focusin', (e) => {
      state.typing = (e.target as Element).matches(
        'input:not([type="checkbox"]):not([type="radio"]), textarea, select',
      );
      render();
    });
    document.addEventListener('focusout', () => {
      state.typing = false;
      render();
    });

    document.addEventListener('menu:toggle', (e) => {
      state.menuOpen = (e as CustomEvent<{ open: boolean }>).detail.open;
      render();
    });
    document.addEventListener('modal:toggle', (e) => {
      state.modalOpen = (e as CustomEvent<{ open: boolean }>).detail.open;
      render();
    });
    document.addEventListener('registration:success', () => {
      state.registered = true;
      render();
    });

    render();
  }
</script>
