---
// EVENT-001 One Page Event Landing (작업지시서 2장 정보 구조)
// Header / Hero / #invitation / #about(서비스·#program·AI meets JEJU·행사 정보) / #registration / Footer
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Invitation from '@/components/Invitation.astro';
import About from '@/components/About.astro';
import Program from '@/components/Program.astro';
import AIJeju from '@/components/AIJeju.astro';
import EventInfo from '@/components/EventInfo.astro';
import Registration from '@/components/Registration.astro';
import Footer from '@/components/Footer.astro';
import FloatingCTA from '@/components/FloatingCTA.astro';
---

<BaseLayout>
  <div id="top"></div>
  <Header />

  <main id="main" tabindex="-1">
    <Hero />
    <Invitation />
    <About>
      <Program />
      <AIJeju />
      <EventInfo />
    </About>
    <Registration />
  </main>

  <Footer />
  <FloatingCTA />
</BaseLayout>
